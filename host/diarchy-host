#!/usr/bin/env python3
# Diarchy host agent launcher.
# Kept syntax-compatible with old interpreters so the version guard below can run.
import json
import os
import sys


# Mirrors diarchy_host.cli.SUBCOMMANDED (a test keeps the two in sync): `kvm <sub>`/`stream <sub>` are one command.
_SUBCOMMANDED = {"kvm": ("configure", "authorize", "start", "stop", "status"), "stream": None}


def _command_name(argv):
    tokens = [token for token in argv if not token.startswith("-")]
    if not tokens:
        return ""
    if tokens[0] in _SUBCOMMANDED and len(argv) > 1 and not argv[1].startswith("-"):
        known = _SUBCOMMANDED[tokens[0]]
        if known is None or argv[1] in known:
            return tokens[0] + " " + argv[1]
    return tokens[0]


def _fail(code, message):
    envelope = {
        "schema": 1, "ok": False, "command": _command_name(sys.argv[1:]),
        "error": {"code": code, "message": message},
    }
    sys.stdout.write(json.dumps(envelope, separators=(",", ":")) + "\n")
    sys.stdout.flush()
    sys.exit(1)


def _find_package_dir():
    home = os.environ.get("HOME")
    candidates = [
        os.environ.get("DIARCHY_AGENT_DIR"),
        os.path.dirname(os.path.realpath(__file__)),
        os.path.join(home, ".local", "share", "diarchy", "agent") if home else None,
    ]
    for candidate in candidates:
        if candidate and os.path.isfile(os.path.join(candidate, "diarchy_host", "__init__.py")):
            return candidate
    return None


def _main():
    if sys.version_info < (3, 11):
        _fail("unsupported_platform", "diarchy-host requires Python 3.11 or newer")
    package_dir = _find_package_dir()
    if package_dir is None:
        _fail("not_installed", "diarchy-host package not found")
    sys.path.insert(0, package_dir)
    try:
        from diarchy_host import cli
    except Exception as error:
        _fail("internal", "cannot load diarchy-host: " + str(error))

    sys.exit(cli.main(sys.argv[1:]))


if __name__ == "__main__":
    _main()
