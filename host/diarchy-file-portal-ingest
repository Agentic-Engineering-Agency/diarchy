#!/usr/bin/env python3
"""Receive one fd-safe portal item and atomically publish it on the host."""

from __future__ import annotations

import ctypes
import errno
import json
import os
import shutil
import stat
import struct
import sys
import time
import uuid
from pathlib import Path, PurePosixPath
from typing import BinaryIO
from urllib.parse import quote

MAX_RECORD_BYTES = 65_536
MAX_ENTRIES = 100_000
RENAME_NOREPLACE = 1
AT_FDCWD = -100
STAGE_PREFIX = ".diarchy-portal-stage-"
# A killed ingest leaves its stage directory behind; only sweep stages old enough to be abandoned.
STALE_STAGE_SECONDS = 3600
# Free space that must remain after a file lands, so one drop cannot fill the disk.
FREE_SPACE_RESERVE = 64 * 1024 * 1024


def read_exact(stream: BinaryIO, size: int) -> bytes:
    chunks: list[bytes] = []
    remaining = size
    while remaining:
        chunk = stream.read(remaining)
        if not chunk:
            raise EOFError("truncated portal stream")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def read_record(stream: BinaryIO) -> dict[str, object]:
    length = struct.unpack("!I", read_exact(stream, 4))[0]
    if not 0 < length <= MAX_RECORD_BYTES:
        raise ValueError("invalid portal record length")
    try:
        record = json.loads(read_exact(stream, length).decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("invalid portal JSON") from exc
    if not isinstance(record, dict):
        raise ValueError("portal record must be an object")
    return record


def valid_basename(value: object) -> str:
    if (
        not isinstance(value, str)
        or not value
        or value in {".", ".."}
        or "/" in value
        or "\x00" in value
        or len(os.fsencode(value)) > 255
    ):
        raise ValueError("invalid portal basename")
    return value


def relative_parts(value: object) -> tuple[str, ...]:
    if value == "":
        return ()
    if not isinstance(value, str) or "\x00" in value or len(os.fsencode(value)) > 4096:
        raise ValueError("invalid portal relative path")
    path = PurePosixPath(value)
    parts = path.parts
    if path.is_absolute() or not parts or any(part in {"", ".", ".."} for part in parts):
        raise ValueError("invalid portal relative path")
    if any(len(os.fsencode(part)) > 255 for part in parts):
        raise ValueError("portal path component is too long")
    return parts


def integer_field(record: dict[str, object], name: str, minimum: int = 0) -> int:
    value = record.get(name)
    if not isinstance(value, int) or isinstance(value, bool) or value < minimum:
        raise ValueError(f"invalid {name}")
    return value


def open_directory(parent_fd: int, name: str) -> int:
    return os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)


def open_parent(root_fd: int, root_name: str, parts: tuple[str, ...]) -> tuple[int, str]:
    current = os.dup(root_fd)
    try:
        current_name = root_name
        if parts:
            current = _replace_fd(current, open_directory(current, root_name))
            for component in parts[:-1]:
                current = _replace_fd(current, open_directory(current, component))
            current_name = parts[-1]
        return current, current_name
    except Exception:
        os.close(current)
        raise


def _replace_fd(old_fd: int, new_fd: int) -> int:
    os.close(old_fd)
    return new_fd


def rename_noreplace(root_fd: int, source: str, destination: str) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = libc.renameat2
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    result = renameat2(
        root_fd,
        os.fsencode(source),
        root_fd,
        os.fsencode(destination),
        RENAME_NOREPLACE,
    )
    if result != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), destination)


def free_bytes(fd: int) -> int:
    status = os.fstatvfs(fd)
    return status.f_bavail * status.f_frsize


def sweep_stale_stages(root: Path, now: float | None = None) -> None:
    cutoff = (time.time() if now is None else now) - STALE_STAGE_SECONDS
    for entry in root.iterdir():
        if not entry.name.startswith(STAGE_PREFIX):
            continue
        try:
            status = entry.lstat()
        except FileNotFoundError:
            continue
        if stat.S_ISDIR(status.st_mode) and status.st_mtime < cutoff:
            shutil.rmtree(entry, ignore_errors=True)


def write_file(stream: BinaryIO, parent_fd: int, name: str, size: int) -> None:
    if size > free_bytes(parent_fd) - FREE_SPACE_RESERVE:
        raise OSError(errno.ENOSPC, "not enough free space on the host")
    fd = os.open(
        name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=parent_fd,
    )
    try:
        remaining = size
        while remaining:
            chunk = stream.read(min(1024 * 1024, remaining))
            if not chunk:
                raise EOFError("truncated portal file body")
            view = memoryview(chunk)
            while view:
                written = os.write(fd, view)
                view = view[written:]
            remaining -= len(chunk)
        os.fsync(fd)
    finally:
        os.close(fd)


def receive_item(stream: BinaryIO, destination_root: Path) -> tuple[str, str]:
    try:
        root_mode = destination_root.lstat().st_mode
    except FileNotFoundError:
        destination_root.mkdir(mode=0o700, parents=True, exist_ok=False)
    else:
        if stat.S_ISLNK(root_mode) or not stat.S_ISDIR(root_mode):
            raise ValueError("unsafe portal destination root")
    root_fd = os.open(destination_root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    os.fchmod(root_fd, 0o700)
    sweep_stale_stages(destination_root)
    stage_name = f"{STAGE_PREFIX}{uuid.uuid4().hex}"
    os.mkdir(stage_name, mode=0o700, dir_fd=root_fd)
    stage_path = destination_root / stage_name
    name = "unknown"
    try:
        start = read_record(stream)
        if start.get("type") != "start":
            raise ValueError("portal stream must start with start")
        name = valid_basename(start.get("name"))
        root_kind = start.get("kind")
        if root_kind not in {"file", "directory"}:
            raise ValueError("invalid portal root kind")

        stage_fd = open_directory(root_fd, stage_name)
        try:
            seen: set[tuple[str, ...]] = set()
            directory_mtimes: list[tuple[tuple[str, ...], int]] = []
            count = 0
            while True:
                record = read_record(stream)
                record_type = record.get("type")
                if record_type == "finish":
                    if integer_field(record, "entries") != count:
                        raise ValueError("portal entry count mismatch")
                    break
                if record_type != "entry":
                    raise ValueError("invalid portal stream record")
                count += 1
                if count > MAX_ENTRIES:
                    raise ValueError("too many portal entries")
                parts = relative_parts(record.get("path"))
                if parts in seen:
                    raise ValueError("duplicate portal entry")
                seen.add(parts)
                kind = record.get("kind")
                if kind not in {"file", "directory"}:
                    raise ValueError("unsupported portal entry kind")
                if not parts and kind != root_kind:
                    raise ValueError("portal root kind mismatch")
                if parts and parts[:-1] not in seen:
                    raise ValueError("portal parent was not declared")
                mtime_ns = integer_field(record, "mtime_ns")
                parent_fd, leaf = open_parent(stage_fd, name, parts)
                try:
                    if kind == "directory":
                        os.mkdir(leaf, mode=0o700, dir_fd=parent_fd)
                        directory_mtimes.append((parts, mtime_ns))
                    else:
                        size = integer_field(record, "size")
                        write_file(stream, parent_fd, leaf, size)
                        os.utime(
                            leaf,
                            ns=(mtime_ns, mtime_ns),
                            dir_fd=parent_fd,
                            follow_symlinks=False,
                        )
                finally:
                    os.close(parent_fd)
            if () not in seen:
                raise ValueError("portal root entry is missing")
            for parts, mtime_ns in reversed(directory_mtimes):
                parent_fd, leaf = open_parent(stage_fd, name, parts)
                try:
                    os.utime(
                        leaf,
                        ns=(mtime_ns, mtime_ns),
                        dir_fd=parent_fd,
                        follow_symlinks=False,
                    )
                finally:
                    os.close(parent_fd)
        finally:
            os.close(stage_fd)

        try:
            rename_noreplace(root_fd, f"{stage_name}/{name}", name)
        except FileExistsError:
            return name, "skipped-exists"
        except OSError as exc:
            if exc.errno == errno.ENOTEMPTY:
                return name, "skipped-exists"
            raise
        return name, "ok"
    finally:
        os.close(root_fd)
        if stage_path.exists():
            shutil.rmtree(stage_path, ignore_errors=True)


def main() -> int:
    root = Path.home() / "Drop" / "from-mac"
    name = "unknown"
    encoded_name = quote(name, safe="")
    try:
        name, status = receive_item(sys.stdin.buffer, root)
        encoded_name = quote(name, safe="")
    except (EOFError, OSError, ValueError) as exc:
        detail = str(exc).replace("\n", " ")[:512]
        print(f"portal-send name={encoded_name} status=failed detail={detail}")
        return 1
    print(f"portal-send name={encoded_name} status={status}")
    return 0 if status == "ok" else 17


if __name__ == "__main__":
    raise SystemExit(main())
