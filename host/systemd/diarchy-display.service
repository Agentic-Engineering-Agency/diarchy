[Unit]
Description=Maintain a capturable Hyprland output for Diarchy
Documentation=https://github.com/Sebastiangmz/diarchy
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/diarchy-display watch
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
